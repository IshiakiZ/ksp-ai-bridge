#!/usr/bin/env python3
"""Print the autopilot's flight recorder as a table:  tools/trace [last] [every]"""
import importlib.machinery, importlib.util, os, sys
here = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader("rpc", os.path.join(here, "rpc")); spec = importlib.util.spec_from_loader("rpc", loader); rpc = importlib.util.module_from_spec(spec); loader.exec_module(rpc)
r = rpc.call("trace", {"last": int(sys.argv[1]) if len(sys.argv) > 1 else 150, "every": int(sys.argv[2]) if len(sys.argv) > 2 else 1})
if not r.get("ok"): sys.exit(str(r))
cols = r["result"]["columns"].split(",")
widths = [7, 5, 6, 7, 6, 6, 6, 7, 6, 5, 7, 6, 6, 7, 8, 0]
print(" ".join(c.rjust(w) for c, w in zip(cols, widths)))
for row in r["result"]["rows"]:
    print(" ".join(c.rjust(w) for c, w in zip(row.split(",", len(cols) - 1), widths)))
